APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# GOWA WhatsApp Gateway Settings
GOWA_BASE_URL=http://gowa:3000
GOWA_USERNAME=user1
GOWA_PASSWORD=pass1
GOWA_WEBHOOK_SECRET=your-secret-key-here
GOWA_DEFAULT_DEVICE_ID=default
GOWA_TARGET_WEBHOOK_URL=http://laravel.test/api/v1/webhooks/whatsapp

# AI Provider & Fallback Configuration
AI_DEFAULT_PROVIDER=gemini

# 1. Primary: Google Gemini
GEMINI_API_KEY=your-gemini-api-key
AI_GEMINI_MODEL=gemini-3.8-flash

# 2. Cadangan 1: Groq Cloud (Ultra Low Latency)
GROQ_API_KEY=your-groq-api-key
AI_GROQ_MODEL=openai/gpt-oss-120b

# 3. Cadangan 2: OpenRouter (Resilient Multi-Model Hub)
OPENROUTER_API_KEY=your-openrouter-api-key
AI_OPENROUTER_MODEL=openai/gpt-oss-20b

# 4. Cadangan 3: Cohere (Enterprise RAG)
COHERE_API_KEY=your-cohere-api-key
AI_COHERE_MODEL=command-r-plus-08-2024

# 5. Cadangan 4: AionLabs (Safety Net)
AIONLABS_API_KEY=your-aionlabs-api-key
AIONLABS_URL=https://api.aionlabs.ai/v1
AI_AIONLABS_MODEL=aion-labs/aion-2.0

# Optional fallbacks
OPENAI_API_KEY=your-openai-api-key
AI_OPENAI_MODEL=gpt-4o-mini
OLLAMA_API_KEY=
OLLAMA_URL=http://localhost:11434
